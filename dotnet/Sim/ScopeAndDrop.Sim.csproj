<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the sim exactly as Unity will: .NET Standard 2.1, C# 9, no Unity references.
    The sources live in the Unity package at sim/Runtime; this project only compiles them for the cloud tests.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>ScopeAndDrop.Sim</AssemblyName>
    <RootNamespace>ScopeAndDrop.Sim</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../sim/Runtime/**/*.cs" />
  </ItemGroup>
</Project>
